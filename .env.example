# 推荐使用 scripts/init-env.ps1 为本地学习环境生成随机值；本文件不是生产配置。
DB_USERNAME=rag
DB_PASSWORD=<GENERATE_LOCAL_DATABASE_PASSWORD>
MYSQL_ROOT_PASSWORD=<GENERATE_LOCAL_ROOT_PASSWORD>
QDRANT_API_KEY=<GENERATE_LOCAL_QDRANT_KEY>
BOOTSTRAP_ENABLED=true
BOOTSTRAP_ALICE_PASSWORD=<GENERATE_LOCAL_ALICE_PASSWORD>
BOOTSTRAP_BOB_PASSWORD=<GENERATE_LOCAL_BOB_PASSWORD>
MYSQL_PORT=3306
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334
SERVER_PORT=8080
# 这两个 Key 必须自行从各平台获取；init-env.ps1 不会生成有效的云 API Key。
ZHIPU_API_KEY=<YOUR_ZHIPU_API_KEY>
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas
ZHIPU_EMBEDDING_DIMENSIONS=2048
DEEPSEEK_API_KEY=<YOUR_DEEPSEEK_API_KEY>
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_CHAT_MODEL=deepseek-flash
QDRANT_COLLECTION=enterprise_knowledge_zhipu_embedding3_2048_v1
